{
  "name": "@anh/enigo-keyboard",
  "version": "0.1.0",
  "description": "Minimal enigo-based keyboard simulator for Node/Electron using Rust + napi-rs.",
  "license": "MPL-2.0",
  "type": "module",

  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "*.node",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build-native.js",
    "build:ci": "node scripts/build-ci.js",
    "build:cross": "node scripts/build-cross-platform.js",
    "build:cross:target": "node scripts/build-cross-platform.js",
    "build:cross:enhanced": "node scripts/build-cross-enhanced.js",
    "build:cross:enhanced:target": "node scripts/build-cross-enhanced.js",
    "build:napi": "napi build --release && npm run build:ts",
    "build:debug": "napi build && npm run build:ts",
    "build:ts": "tsc -p tsconfig.json",
    "clean": "cargo clean"
  },
  "keywords": [
    "enigo",
    "keyboard",
    "napi",
    "rust"
  ],
  "devDependencies": {
    "@napi-rs/cli": "latest",
    "@types/node": "^20.17.9",
    "typescript": "^5.8.3"
  },
  "napi": {
    "binaryName": "enigo_keyboard"
  }
}
