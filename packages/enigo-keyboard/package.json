{
  "name": "@anh/enigo-keyboard",
  "version": "0.1.0",
  "description": "Minimal enigo-based keyboard simulator for Node/Electron using Rust + napi-rs.",
  "license": "MPL-2.0",
  "main": "dist/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "*.node"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "napi build --release && npm run build:ts",
    "build:debug": "napi build && npm run build:ts",
    "build:ts": "tsc -p tsconfig.json",
    "clean": "cargo clean"
  },
  "keywords": [
    "enigo",
    "keyboard",
    "napi",
    "rust"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^3.5.0",
    "@types/node": "^20.17.9",
    "typescript": "^5.8.3"
  },
  "napi": {
    "name": "enigo_keyboard"
  },
  "dependencies": {
    "andrea-novel-helper": "file:../.."
  }
}
