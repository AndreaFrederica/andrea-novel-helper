!packages/enigo-keyboard/
packages/enigo-keyboard/**
!packages/enigo-keyboard/dist/
!packages/enigo-keyboard/dist/**
!packages/enigo-keyboard/*.node
!packages/enigo-keyboard/package.json
!packages/enigo-keyboard/README.md
