#set page(width: 21cm, height: 29.7cm, margin: 2cm)

#let theme = (
  text-font: "{{ meta.text_font | default: 'Noto Sans SC' }}",
  heading-font: "{{ meta.heading_font | default: 'Noto Sans SC' }}",
  text-size: {{ meta.text_size | default: 18 }}pt,
  title-size: {{ meta.title_size | default: 40 }}pt,
  sub-size: {{ meta.sub_size | default: 18 }}pt,
  color: rgb("#111"),
  gray: rgb("#6b7280"),
  line-height: {{ meta.line_height | default: 1.3 }},
  indent: 2em,
  para-spacing: 1.2em,
)

#let zh-paragraph() = {
  set par(justify: true, first-line-indent: theme.indent, leading: theme.line-height * 1em, spacing: theme.para-spacing)
  set text(lang: "zh", font: theme.text-font, size: theme.text-size, fill: theme.color)
}

#let title = "{{ meta.title | default: '' }}"
#let subtitle = "{{ meta.subtitle | default: '' }}"

#set text(font: theme.heading-font, weight: "bold")
#if (title != none and title != "") [
  #text(size: theme.title-size)[#title]
]

#if (subtitle != none) [
  #v(6pt)
  #set text(font: theme.heading-font, size: theme.sub-size, fill: theme.gray)
  #subtitle
  #v(10pt)
] else [
  #v(6pt)
]

{% for b in blocks %}
{% if b.type == 'heading' %}
{% if meta.main_title_text and b.level == 1 and b.text == meta.main_title_text %}
{% else %}
#heading(level: {{ b.level | default: 2 }}, [{{ b.text }}])
{% endif %}
{% elsif b.type == 'paragraph' %}
#zh-paragraph()
{{ b.text | md2typst }}
{% elsif b.type == 'code' %}
#set text(font: "{{ meta.mono_font | default: 'Consolas' }}", size: {{ meta.sub_size | default: 12 }}pt)
[{{ b.code }}]
{% elsif b.type == 'list' %}
#zh-paragraph()
{% if b.ordered %}
{% for it in b.items %}{{ forloop.index }}. {{ it | md2typst }}
{% endfor %}
{% else %}
{% for it in b.items %}• {{ it | md2typst }}
{% endfor %}
{% endif %}
{% elsif b.type == 'blockquote' %}
#box(inset: 8pt)[
#set text(fill: theme.gray)
{{ b.text | md2typst }}
]
{% elsif b.type == 'image' %}
#image("{{ b.src }}")
{% elsif b.type == 'hr' %}
---
{% endif %}
{% endfor %}