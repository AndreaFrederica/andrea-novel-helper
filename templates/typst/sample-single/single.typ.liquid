--- meta ---
{ "name": "sample-single", "entry": "entry" }
--- end ---

--- part: prelude ---
#let zh-paragraph() = {
  set par(justify: true, first-line-indent: 2em, leading: 1em, spacing: 2em)
}

--- part: entry ---
#set page(width: 21cm, height: 29.7cm, margin: 2cm)

{% if meta.title %}
#heading(level: 1, [{{ meta.title }}])
#v(10pt)
{% endif %}

{% for b in blocks %}
{% if b.type == 'heading' %}
{% if meta.main_title_text and b.level == 1 and b.text == meta.main_title_text %}
{% else %}
#heading(level: {{ b.level | default: 1 }}, [{{ b.text }}])
{% endif %}
{% elsif b.type == 'paragraph' %}
#zh-paragraph()
{{ b.text | md2typst }}
{% elsif b.type == 'code' %}
#set text(font: "{{ meta.mono_font | default: 'Consolas' }}", size: {{ meta.sub_size | default: 12 }}pt)
[{{ b.code }}]
{% elsif b.type == 'list' %}
#zh-paragraph()
{% if b.ordered %}
{% for it in b.items %}{{ forloop.index }}. {{ it | md2typst }}
{% endfor %}
{% else %}
{% for it in b.items %}• {{ it | md2typst }}
{% endfor %}
{% endif %}
{% elsif b.type == 'blockquote' %}
#box(inset: 8pt)[
#set text(fill: theme.gray)
{{ b.text | md2typst }}
]
{% elsif b.type == 'image' %}
#image("{{ b.src }}")
{% elsif b.type == 'hr' %}
---
{% endif %}
{% endfor %}